<Project Sdk="Microsoft.NET.Sdk">
  <!-- WebView2 baseline, published Native AOT like the fastest C# host so the
       comparison is engine against engine. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType><AssemblyName>Feas008WebView</AssemblyName><RootNamespace>Feas008</RootNamespace>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI><WinUISDKReferences>false</WinUISDKReferences>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType><WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <ApplicationManifest>../csharp/app.manifest</ApplicationManifest>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishAot>true</PublishAot><IsAotCompatible>true</IsAotCompatible>
    <BaseOutputPath>../../../../build/feas008/webview/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../csharp/Native.cs" Link="Native.cs" />
    <Compile Include="../csharp/Platform.cs" Link="Platform.cs" />
    <ApplicationDefinition Include="../csharp/App.xaml" Link="App.xaml" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>
</Project>
