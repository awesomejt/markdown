          "required": [
            "kind",
            "reason"
          ]
        }
      ]
    },
    "LinkId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "LinkIntent": {
      "type": "object",
      "properties": {
        "destination": {
          "type": "string"
        },
        "disposition": {
