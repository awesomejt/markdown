      "items": {
        "$ref": "#/$defs/NodeId"
      }
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    }
  },
  "additionalProperties": false,
  "required": [
    "model_version",
    "document_id",
    "revision_id",
    "source",
    "capabilities",
    "roots",
    "nodes",
    "outline",
    "metadata",
    "links",
    "resources",
    "diagnostics"
