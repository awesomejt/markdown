            "kind": {
              "type": "string",
              "const": "strong"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NodeId"
              }
            },
            "kind": {
              "type": "string",
              "const": "strikethrough"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "children"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "code_span"
            },
            "text": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "soft_break"
