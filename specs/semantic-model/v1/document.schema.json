            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "label"
          ]
        },
        {
          "type": "object",
          "properties": {
            "feature": {
              "type": "string"
            },
            "kind": {
              "type": "string",
