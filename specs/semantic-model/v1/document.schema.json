    "Alignment": {
      "type": "string",
      "enum": [
        "none",
        "left",
        "center",
        "right"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "tables",
        "task_lists",
        "footnotes",
        "strikethrough",
        "front_matter",
        "alerts"
      ]
